# Copia este archivo a .env.local para trabajar en local.
# En Vercel, defínelas en: Project Settings -> Environment Variables.
# El archivo real (.env.local) NO se sube a GitHub.

# Supabase (Project Settings -> API). La anon key es pública por diseño,
# por eso la seguridad depende de las políticas RLS (ver supabase-rls.sql).
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_de_supabase

# Google AI Studio. SIN prefijo NEXT_PUBLIC_: solo la ve el servidor.
GEMINI_API_KEY=tu_api_key_de_gemini

# Opcional: modelos a intentar, en orden y separados por comas.
# Si Google retira un modelo, basta con cambiar esta variable.
GEMINI_MODELS=gemini-3.8-flash,gemini-2.0-flash
